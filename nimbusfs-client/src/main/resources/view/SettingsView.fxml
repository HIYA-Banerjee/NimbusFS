<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.nimbusfs.client.controller.SettingsController" styleClass="root" maxWidth="600">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="⚙ System Settings" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #58a6ff;"/>

    <VBox spacing="15" styleClass="card">
        <Label text="Master Server Connection" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
        <GridPane hgap="10" vgap="10">
            <Label text="Master IP:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="serverIpField" text="localhost" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="Master Port:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="serverPortField" text="9000" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="Transport Security:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <CheckBox fx:id="tlsCheck" text="Enable TLS 1.3 Encryption in Transit" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        </GridPane>
    </VBox>

    <VBox spacing="15" styleClass="card">
        <Label text="System Defaults" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
        <GridPane hgap="10" vgap="10">
            <Label text="Default Replication:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <ComboBox fx:id="replicationCombo" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="Theme Mode:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <ComboBox fx:id="themeCombo" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        </GridPane>
    </VBox>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Save Settings" onAction="#handleSave" styleClass="primary-button"/>
    </HBox>
</VBox>
