<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.nimbusfs.client.controller.AdminController" styleClass="root">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="👑 Admin System Overview" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #58a6ff;"/>

    <HBox spacing="20">
        <VBox styleClass="card" HBox.hgrow="ALWAYS" alignment="CENTER">
            <Label text="Total Users" style="-fx-text-fill: #8b949e;"/>
            <Label fx:id="totalUsersLabel" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #58a6ff;"/>
        </VBox>
        <VBox styleClass="card" HBox.hgrow="ALWAYS" alignment="CENTER">
            <Label text="Files Stored" style="-fx-text-fill: #8b949e;"/>
            <Label fx:id="totalFilesLabel" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #3fb950;"/>
        </VBox>
        <VBox styleClass="card" HBox.hgrow="ALWAYS" alignment="CENTER">
            <Label text="Storage Used" style="-fx-text-fill: #8b949e;"/>
            <Label fx:id="totalStorageLabel" text="0 GB" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #d29922;"/>
        </VBox>
        <VBox styleClass="card" HBox.hgrow="ALWAYS" alignment="CENTER">
            <Label text="Total Nodes" style="-fx-text-fill: #8b949e;"/>
            <Label fx:id="totalNodesLabel" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #a371f7;"/>
        </VBox>
    </HBox>

    <Label text="Registered Users" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
    <TableView fx:id="userTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="userIdCol" text="User ID" prefWidth="200"/>
            <TableColumn fx:id="usernameCol" text="Username" prefWidth="180"/>
            <TableColumn fx:id="roleCol" text="Role" prefWidth="120"/>
            <TableColumn fx:id="createdCol" text="Created At" prefWidth="200"/>
        </columns>
    </TableView>
</VBox>
